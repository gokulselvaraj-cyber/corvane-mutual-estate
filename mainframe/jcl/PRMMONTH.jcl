//PRMMONTH JOB (CORV,BILL),'MONTHLY IPT RECON',CLASS=B,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*================================================================
//* PRMMONTH  MONTHLY INSURANCE PREMIUM TAX RECONCILIATION
//* SCHEDULE: 1ST WORKING DAY OF THE MONTH, 06:00 EUROPE/LONDON.
//* STEP010 SORT  SUMS THE MONTH'S BILLING GENERATIONS BY LINE AND
//*               REGION (BILLREC OFFSETS: LINE 13-15, REGION 47-48,
//*               PREMIUM 24-34, IPT 35-43, ZONED DECIMAL).
//* STEP020 COPY  THE SUMMARY TO FINANCE (CORV.FIN.IPT.MONTHLY).
//* THE WAREHOUSE VIEW dw.v_premium_by_line SHOULD AGREE WITH THIS
//* SUMMARY FOR UK LINES; FINANCE CHECKS BOTH EACH MONTH.
//*================================================================
//STEP010  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=CORV.PRM.BILLING.DAILY,DISP=SHR
//SORTOUT  DD DSN=&&IPTSUM,DISP=(NEW,PASS),
//            SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=64,BLKSIZE=27968)
//SYSIN    DD *
  SORT FIELDS=(13,3,CH,A,47,2,CH,A)
  SUM FIELDS=(24,11,ZD,35,9,ZD)
/*
//STEP020  EXEC PGM=IEBGENER,COND=(0,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&IPTSUM,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=CORV.FIN.IPT.MONTHLY(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=64,BLKSIZE=27968)
//*================================================================
//* ADDED 2026-01 (CHG-91020): REINSURANCE BORDEREAUX FOR THE 2026
//* TREATY PANEL, AFTER THE IPT SUMMARY.
//* STEP080 RINSCALC (PL/I) EFFECTIVE CESSION SHARE PER LINE
//* STEP090 RIBORDX  PREMIUM AND CLAIMS BORDEREAUX FOR THE BROKER
//*================================================================
//STEP080  EXEC PGM=RINSCALC,COND=(0,LT)
//STEPLIB  DD DSN=CORV.PROD.LOADLIB,DISP=SHR
//TREATY   DD DSN=CORV.RI.TREATY.TERMS,DISP=SHR
//POLMAST  DD DSN=CORV.POLMAST,DISP=SHR
//CESSTAB  DD DSN=&&CESSTAB,DISP=(NEW,PASS),
//            SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=40,BLKSIZE=27960)
//SYSPRINT DD SYSOUT=*
//*
//STEP090  EXEC PGM=RIBORDX,COND=(0,LT)
//STEPLIB  DD DSN=CORV.PROD.LOADLIB,DISP=SHR
//BILLING  DD DSN=CORV.PRM.BILLING.DAILY,DISP=SHR
//CLMMAST  DD DSN=CORV.CLMMAST,DISP=SHR
//POLMAST  DD DSN=CORV.POLMAST,DISP=SHR
//CESSTAB  DD DSN=&&CESSTAB,DISP=(OLD,DELETE)
//BORDX    DD DSN=CORV.RI.BORDX.MONTHLY(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=160,BLKSIZE=27840)
//SYSOUT   DD SYSOUT=*
