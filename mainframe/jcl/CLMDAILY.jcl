//CLMDAILY JOB (CORV,CLMS),'CLAIMS DAILY',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*================================================================
//* CLMDAILY  CLAIMS DAILY HOUSEKEEPING - SYSTEM CORVMF
//*	SCHEDULE: 22:00 EUROPE/LONDON, EVERY DAY.
//*	STEP005 CLMFEED APPLIES THE DAY'S POSTGRES CHANGES TO CLMMAST
//*	STEP010 BACKUP OF CORV.CLMMAST (IDCAMS REPRO)
//*	STEP020 CLMHIST CLAIMS HISTORY FOR FINANCE (13 MONTHS)
//*	CLMPURGE WAS STEP030 UNTIL THE 2024 MIGRATION. IT IS NOT RUN
//*	ANY MORE: claims.purge_expired_claims() IN POSTGRES OWNS
//*	RETENTION NOW.
//*	THIS MEMBER WAS EDITED ON A PC AND HAS CRLF LINE ENDINGS AND
//*	TAB CHARACTERS IN THE COMMENTS.
//*================================================================
//JOBLIB   DD DSN=CORV.PROD.LOADLIB,DISP=SHR
//*
//STEP005  EXEC PGM=CLMFEED
//CLMFEED  DD DSN=CORV.CLM.FEED,DISP=(OLD,DELETE,KEEP)
//CLMMAST  DD DSN=CORV.CLMMAST,DISP=OLD
//SYSOUT   DD SYSOUT=*
//*
//STEP010  EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//BACKUP   DD DSN=CORV.CLMMAST.BACKUP(+1),DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(30,10),RLSE),
//            DCB=(RECFM=FB,LRECL=300,BLKSIZE=27900)
//SYSIN    DD *
  REPRO INFILE(CLMMAST) OUTFILE(BACKUP)
/*
//CLMMAST  DD DSN=CORV.CLMMAST,DISP=SHR
//*
//STEP020  EXEC PGM=CLMHIST,COND=(0,LT)
//CLMMAST  DD DSN=CORV.CLMMAST,DISP=SHR
//PARMIN   DD DSN=CORV.PARMLIB(CLMPARM01),DISP=SHR
//CLMHIST  DD DSN=CORV.CLM.HISTORY(+1),DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=300,BLKSIZE=27900)
//SYSOUT   DD SYSOUT=*
