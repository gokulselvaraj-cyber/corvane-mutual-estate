//PRMRERUN JOB (CORV,BILL),'PRMNIGHT RESTART',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,RESTART=STEP020
//*================================================================
//* PRMRERUN  RESTART OF THE NIGHTLY PREMIUM BILLING - SYSTEM CORVMF
//* MEMBER OF CORV.PROCLIB. SUBMITTED BY HAND BY THE MAINFRAME
//* ON-CALL WHEN PRMNIGHT ABENDS IN STEP020 OR STEP030.
//*           OWNED BY TEAM-MAINFRAME (@corvane/mainframe-billing).
//* STEP020 PRMCALC  RATE, EXCESS, IPT          EXTRACT -> RATED
//* STEP030 PRMBILL  DAILY BILLING FILE         RATED -> BILLING
//* BEFORE SUBMITTING:
//*   1. CORV.PRM.EXTRACT FROM THE FAILED RUN MUST STILL BE
//*      CATALOGUED (STEP020 KEEPS IT WHEN IT ABENDS).
//*   2. DELETE CORV.PRM.RATED IF THE FAILED STEP020 ALLOCATED IT.
//*   3. DELETE THE NEW CORV.PRM.BILLING.DAILY GENERATION IF THE
//*      FAILED STEP030 CREATED ONE.
//*   4. RUN IT BEFORE 04:00 OR TELL TEAM-DATA-PLATFORM.
//* STEP040 (SFTP) DELIBERATELY NOT INCLUDED - SEE
//*         ops/runbooks/prmnight-failure.md
//*================================================================
//JOBLIB   DD DSN=CORV.PROD.LOADLIB,DISP=SHR
//*
//STEP020  EXEC PGM=PRMCALC
//EXTRACT  DD DSN=CORV.PRM.EXTRACT,DISP=(OLD,DELETE,KEEP)
//PARMIN   DD DSN=CORV.PARMLIB(PRMPARM01),DISP=SHR
//RATED    DD DSN=CORV.PRM.RATED,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(20,5),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=27960)
//SYSOUT   DD SYSOUT=*
//*
//STEP030  EXEC PGM=PRMBILL,COND=(4,LT)
//RATED    DD DSN=CORV.PRM.RATED,DISP=(OLD,DELETE,KEEP)
//BILLING  DD DSN=CORV.PRM.BILLING.DAILY(+1),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=64,BLKSIZE=27968)
//REJECTS  DD SYSOUT=*
//REFERRAL DD SYSOUT=(R,,UWRF)
//SYSOUT   DD SYSOUT=*
//*
//* END OF PRMRERUN. CHECK THE STEP030 RECORD COUNT AGAINST THE
//* PRMCALC "POLICIES RATED" LINE IN SYSOUT BEFORE CLOSING THE
//* INCIDENT.
