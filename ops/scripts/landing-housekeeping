#!/bin/bash
# landing-housekeeping - tidies the billing landing zone on the SFTP landing host.
# Installed by the Ansible sftp_landing role (infra/ansible/roles/sftp_landing) and run from cron at 05:30,
# after the premium_billing_load DAG has picked up the night's file. Owner: team-platform-ops.
# Files older than KEEP_DAYS are removed from /landing/billing/; the landing bucket keeps its own copy.
set -euo pipefail
LANDING="${LANDING_DIR:-/landing/billing}"
KEEP_DAYS="${KEEP_DAYS:-14}"
echo "landing-housekeeping: $(date -u +%FT%TZ) tidying ${LANDING}, keeping ${KEEP_DAYS} days"
python3 - "$LANDING" "$KEEP_DAYS" <<'PY'
import os, sys, time
root, keep = sys.argv[1], int(sys.argv[2])
cutoff = time.time() - keep * 86400
removed = kept = 0
for name in sorted(os.listdir(root)):
    path = os.path.join(root, name)
    if not os.path.isfile(path) or name.startswith("."):
        continue
    if os.path.getmtime(path) < cutoff:
        os.remove(path)
        removed += 1
    else:
        kept += 1
print(f"removed {removed} file(s), kept {kept}")
PY
