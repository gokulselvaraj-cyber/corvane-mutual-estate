      "type": "string"
    },
    {
      "name": "policyStartDate",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "claimedAmount",
      "type": "string"
    },
    {
      "name": "currency",
      "type": "string"
    },
    {
      "name": "lossCause",
      "type": "string"
    },
    {
      "name": "narrative",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "injuryNotes",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "occurredAt",
      "type": "string"
    }
  ]
}