    {
      "name": "claimId",
      "type": "string"
    },
    {
      "name": "claimNumber",
      "type": "string"
    },
    {
      "name": "policyNumber",
      "type": "string"
    },
    {
      "name": "lineCode",
      "type": "string"
    },
    {
      "name": "status",
      "type": "string"
    },
    {
      "name": "triageOutcome",
      "type": "string"
    },
    {
      "name": "claimantName",
      "type": "string"
    },
    {
      "name": "claimantEmail",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "claimantMobile",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "postcode",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "lossDate",
      "type": "string"
    },
    {
