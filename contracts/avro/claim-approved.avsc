      "type": "int"
    },
    {
      "name": "policyNumber",
      "type": "string"
    },
    {
      "name": "lineCode",
      "type": "string"
    },
    {
      "name": "payeeName",
      "type": "string"
    },
    {
      "name": "payeeSortCode",
      "type": "string"
    },
    {
      "name": "payeeAccount",
      "type": "string"
    },
    {
      "name": "settlementAmount",
      "type": "string"
    },
    {
      "name": "currency",
      "type": "string"
    },
    {
      "name": "approvedBy",
      "type": "string"
    },
    {
      "name": "occurredAt",
      "type": "string"
    }
  ]
}